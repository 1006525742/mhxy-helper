<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mhxy.asset</string>

    <!-- 资产登记后端：backend_asset.py 内部自行 uvicorn.run(port=8012) -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>backend_asset.py</string>
    </array>

    <!-- 工作目录：mhxy-helper/backend -->
    <key>WorkingDirectory</key>
    <string>/Users/zhy/mhxy-helper/backend</string>

    <!-- 登录自启 + 崩溃自动重启 -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- 日志 -->
    <key>StandardOutPath</key>
    <string>/tmp/asset.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/asset.stdout.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
