<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mhxy.wuji</string>

    <!-- 物价手册/记账本后端：jizhang_server.py 内部自行 uvicorn.run(port=8006) -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>jizhang_server.py</string>
    </array>

    <!-- 工作目录：已迁移至 mhxy-helper/wuji（2026-08-04 从 m-996cajd/mhxy_web 迁入） -->
    <key>WorkingDirectory</key>
    <string>/Users/zhy/mhxy-helper/wuji</string>

    <!-- 登录自启 + 崩溃自动重启 -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- 日志 -->
    <key>StandardOutPath</key>
    <string>/tmp/wuji.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/wuji.stdout.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
